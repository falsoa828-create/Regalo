                <strong>Nota tecnica:</strong> Stai aprendo il file in locale. Per far funzionare il QR code su un altro telefono, carica questa pagina online (es. GitHub Pages, Netlify o Tiiny.host) oppure inserisci qui il link pubblico:
                <input type="text" id="custom-url-input" placeholder="https://tuolink.it/sorpresa" class="mt-2 w-full bg-black/70 border border-amber-500/40 rounded-lg px-2.5 py-1.5 text-white text-xs focus:outline-none focus:border-amber-400">
            </div>

            <button id="preview-experience-btn" class="w-full py-3 rounded-xl bg-gradient-to-r from-zinc-200 to-zinc-400 text-black font-bold text-sm tracking-wider uppercase hover:from-white hover:to-zinc-300 transition shadow-lg">
                Simula Esperienza Biglietto &rarr;
            </button>
        </div>
    </main>

    <!-- ===================================================================== -->
    <!-- SEZIONE 2: ESPERIENZA PRINCIPALE (Sfondo Nero + Pacchetto Argentato)  -->
    <!-- ===================================================================== -->
    <main id="gift-screen" class="z-20 flex-1 flex flex-col items-center justify-center px-4 py-6 w-full max-w-lg relative">
        
        <!-- Contenitore principale del pacchetto / biglietto -->
        <div id="package-stage" class="relative w-full max-w-sm aspect-[3/4.3] flex items-center justify-center">
            
            <!-- 1. IL BIGLIETTO RIVELATO (Sotto l'involucro argentato) -->
            <div id="revealed-ticket" class="w-full h-full bg-gradient-to-b from-zinc-950 via-stone-950 to-black border-2 border-amber-400 rounded-3xl p-5 flex flex-col justify-between spice-glow opacity-0 scale-95 transition-all duration-1000">
                
                <!-- Riflesso lucido dinamico che segue il tocco -->
                <div id="ticket-glare"></div>

                <!-- Intestazione Biglietto -->
                <div>
                    <div class="flex justify-between items-center border-b border-amber-500/20 pb-3 mb-3">
                        <span class="text-[10px] uppercase tracking-[0.25em] text-amber-400 font-semibold">Biglietto Ufficiale</span>
                        <span class="text-[10px] uppercase tracking-widest text-sky-400 eyes-of-ibad font-bold">★ IMAX / CINEMA</span>
                    </div>

                    <!-- Artwork Cinematografico Dune: Parte Tre (SVG integrato ad alta risoluzione) -->
                    <div class="relative w-full h-44 sm:h-48 rounded-2xl overflow-hidden border border-amber-500/30 mb-4 bg-black">
                        <svg viewBox="0 0 600 340" class="w-full h-full object-cover" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <radialGradient id="arrakisSun" cx="50%" cy="38%" r="55%">
                                    <stop offset="0%" stop-color="#fde68a"/>
                                    <stop offset="30%" stop-color="#f59e0b"/>
                                    <stop offset="65%" stop-color="#9a3412"/>
                                    <stop offset="100%" stop-color="#090504"/>
                                </radialGradient>
                                <linearGradient id="duneBack" x1="0%" y1="0%" x2="0%" y2="100%">
                                    <stop offset="0%" stop-color="#78350f"/>
                                    <stop offset="100%" stop-color="#1c0a00"/>
                                </linearGradient>
                                <linearGradient id="duneFront" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#b45309"/>
                                    <stop offset="50%" stop-color="#451a03"/>
                                    <stop offset="100%" stop-color="#050302"/>
                                </linearGradient>
                                <filter id="glowBlue" x="-50%" y="-50%" width="200%" height="200%">
                                    <feGaussianBlur stdDeviation="2.5" result="coloredBlur"/>
                                    <feMerge>
                                        <feMergeNode in="coloredBlur"/>
                                        <feMergeNode in="SourceGraphic"/>
                                    </feMerge>
                                </filter>
                            </defs>

                            <!-- Cielo e Grande Sole di Arrakis -->
                            <rect width="600" height="340" fill="url(#arrakisSun)"/>
                            <circle cx="300" cy="125" r="78" fill="#fef3c7" opacity="0.85"/>
                            <circle cx="300" cy="125" r="95" fill="#f59e0b" opacity="0.25"/>

                            <!-- Sagoma Verme delle Sabbie (Shai-Hulud) sullo sfondo -->
                            <path d="M 430 220 Q 455 115 510 135 Q 545 150 530 230 Z" fill="#1f0d05" opacity="0.85"/>
                            <ellipse cx="498" cy="148" rx="18" ry="26" transform="rotate(-25 498 148)" fill="#090402" stroke="#78350f" stroke-width="2"/>

                            <!-- Dune Posteriori -->
                            <path d="M 0 215 Q 160 165 340 210 T 600 190 L 600 340 L 0 340 Z" fill="url(#duneBack)"/>

                            <!-- Dune Anteriori -->
                            <path d="M 0 250 Q 220 205 420 255 T 600 240 L 600 340 L 0 340 Z" fill="url(#duneFront)"/>

                            <!-- Figura Incappucciata del Muad'Dib sul crinale -->
                            <path d="M 278 242 L 288 182 Q 300 168 312 182 L 324 242 Z" fill="#090707"/>
                            <!-- Mantello al vento -->
                            <path d="M 288 188 Q 255 202 238 228 Q 268 225 284 218 Z" fill="#0c0a09"/>
                            <!-- Occhi Blu di Ibad -->
                            <circle cx="296" cy="184" r="2.2" fill="#38bdf8" filter="url(#glowBlue)"/>
                            <circle cx="304" cy="184" r="2.2" fill="#38bdf8" filter="url(#glowBlue)"/>

                            <!-- Titolo DUNE: PARTE TRE sovraimpresso -->
                            <text x="300" y="294" text-anchor="middle" fill="#fef3c7" font-family="Cinzel, serif" font-weight="900" font-size="34" letter-spacing="14">DUNE</text>
                            <text x="300" y="318" text-anchor="middle" fill="#fbbf24" font-family="Cinzel, serif" font-weight="600" font-size="13" letter-spacing="8">PARTE TRE</text>
                        </svg>
                        
                        <!-- Badge Messia di Dune -->
                        <div class="absolute top-2.5 right-2.5 bg-black/70 backdrop-blur-sm border border-amber-500/40 px-2.5 py-0.5 rounded-full">
                            <span class="text-[9px] uppercase tracking-widest text-amber-300">Messia di Dune</span>
                        </div>
                    </div>

                    <!-- La Frase Richiesta dall'Utente -->
                    <blockquote class="text-center px-1 my-2">
                        <p class="font-dune text-sm sm:text-base font-semibold text-amber-100 leading-relaxed tracking-wide">
                            “Il Muad'Dib ci aspetta. Preparati per vedere il terzo capitolo della saga con il tuo biglietto in regalo”
                        </p>
                    </blockquote>
                </div>

                <!-- Sezione inferiore traforata del biglietto -->
                <div class="ticket-perforation pt-3 mt-2">
                    <div class="flex justify-between items-end text-xs">
                        <div>
                            <p class="text-[10px] uppercase tracking-wider text-zinc-500">Destinazione</p>
                            <p class="font-semibold text-amber-300">ARRAKIS • SALA CINEMA</p>
                        </div>
                        <div class="text-right">
                            <p class="text-[10px] uppercase tracking-wider text-zinc-500">Capitolo</p>
                            <p class="font-bold text-amber-200/80">DUNE: PARTE TRE</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. L'INVOLUCRO ARGENTATO (Sopra il biglietto, si apre scuotendo) -->
            <div id="silver-wrapper" class="absolute inset-0 z-10 flex cursor-pointer">
                <!-- Metà sinistra dell'involucro argentato -->
                <div class="foil-half-left w-1/2 h-full silver-foil rounded-l-3xl border-r border-zinc-400/50 flex items-center justify-end pr-1">
                    <div class="h-4/5 w-[1px] bg-gradient-to-b from-transparent via-white/70 to-transparent"></div>
                </div>
                
                <!-- Metà destra dell'involucro argentato -->
                <div class="foil-half-right w-1/2 h-full silver-foil rounded-r-3xl border-l border-zinc-600/40 flex items-center justify-start pl-1">
                    <div class="h-4/5 w-[1px] bg-gradient-to-b from-transparent via-black/30 to-transparent"></div>
                </div>

                <!-- Sigillo centrale e istruzioni sopra la confezione argentata -->
                <div id="wrapper-seal" class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center pointer-events-none transition-opacity duration-500">
                    <!-- Emblema circolare metallico -->
                    <div class="w-24 h-24 rounded-full bg-zinc-900/90 border-2 border-zinc-300/80 shadow-[0_0_25px_rgba(255,255,255,0.4)] flex flex-col items-center justify-center mb-5 backdrop-blur-sm">
                        <!-- Icona telefono che vibra -->
                        <svg class="w-9 h-9 text-zinc-100 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                    </div>

                    <div class="bg-black/80 backdrop-blur-md border border-white/20 px-5 py-3.5 rounded-2xl shadow-2xl max-w-[260px]">
                        <p class="font-dune text-xs font-bold text-white tracking-[0.2em] mb-1">PACCHETTO SIGILLATO</p>
                        <p class="text-xs text-zinc-300 leading-snug">
                            Scuoti energicamente il telefono per strappare l'involucro argentato!
                        </p>
                    </div>

                    <!-- Barra di progresso dello scuotimento -->
                    <div class="w-44 h-1.5 bg-black/60 rounded-full overflow-hidden mt-4 border border-white/20">
                        <div id="shake-progress-bar" class="h-full bg-gradient-to-r from-sky-400 to-amber-400 w-0 transition-all duration-200"></div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Pulsanti di controllo sotto il pacchetto (Per permessi sensori iOS e fallback tap) -->
        <div id="controls-area" class="mt-6 flex flex-col items-center gap-3 z-20 w-full max-w-xs">
            <!-- Pulsante richiesto da iOS Safari per attivare l'accelerometro e l'audio -->
            <button id="enable-sensors-btn" class="w-full py-3.5 px-5 rounded-2xl bg-zinc-900 border border-zinc-600 text-zinc-100 font-semibold text-xs uppercase tracking-widest hover:bg-zinc-800 active:scale-95 transition shadow-xl flex items-center justify-center gap-2">
                <span>📳</span> Attiva Sensori di Movimento
            </button>

            <!-- Pulsante alternativo per aprire con un tocco (utile su PC o se si preferisce cliccare) -->
            <button id="manual-open-btn" class="text-xs text-zinc-500 hover:text-amber-400 underline underline-offset-4 transition py-1">
                Oppure tocca qui per aprire manualmente
            </button>
        </div>

    </main>

    <!-- Footer discreto senza riferimenti prima dell'apertura -->
    <footer id="page-footer" class="z-20 p-3 text-center text-[10px] text-zinc-600 tracking-widest uppercase">
        Pacchetto Protetto • Scuoti per svelare
    </footer>

    <!-- Contenitore invisibile per il player ufficiale YouTube della colonna sonora originale di Hans Zimmer -->
    <div id="youtube-audio-container" class="fixed -bottom-96 -left-96 w-1 h-1 opacity-0 pointer-events-none overflow-hidden" aria-hidden="true"></div>

    <!-- ===================================================================== -->
    <!-- LOGICA JAVASCRIPT: QR Code, Accelerometro, Colonna Sonora & Immagine  -->
    <!-- ===================================================================== -->
    <script>
        // Stato dell'applicazione
        let isUnwrapped = false;
        let shakeEnergy = 0;
        const SHAKE_THRESHOLD = 14; // Sensibilità accelerometro
        const ENERGY_TO_OPEN = 100; // Energia accumulata necessaria per aprire il pacchetto
        let lastShakeTime = 0;
        let isAudioPlaying = false;
        let isAudioMuted = false;
        let duneSynthLoop = null;
        let ytPlayer = null;
        let ytReady = false;

        // Caricamento API ufficiale YouTube IFrame per riprodurre la traccia originale di Hans Zimmer
        const ytScriptTag = document.createElement('script');
        ytScriptTag.src = "https://www.youtube.com/iframe_api";
        document.head.appendChild(ytScriptTag);

        // ID video ufficiale colonna sonora originale: "Paul's Dream" - Hans Zimmer (Dune Official Soundtrack)
        const ZIMMER_TRACK_ID = "93A1ryc-WW0";

        window.onYouTubeIframeAPIReady = function() {
            ytPlayer = new YT.Player('youtube-audio-container', {
                height: '10',
                width: '10',
                videoId: ZIMMER_TRACK_ID,
                playerVars: {
                    autoplay: 0,
                    controls: 0,
                    loop: 1,
                    playlist: ZIMMER_TRACK_ID,
                    playsinline: 1,
                    start: 52 // Parte direttamente dal celebre tema vocale / ritornello di Hans Zimmer
                },
                events: {
                    onReady: function() {
                        ytReady = true;
                    },
                    onError: function() {
                        ytReady = false;
                    }
                }
            });
        };

        // Elementi DOM
        const qrScreen = document.getElementById('qr-screen');
        const giftScreen = document.getElementById('gift-screen');
        const toggleQrBtn = document.getElementById('toggle-qr-btn');
        const previewExpBtn = document.getElementById('preview-experience-btn');
        const silverWrapper = document.getElementById('silver-wrapper');
        const wrapperSeal = document.getElementById('wrapper-seal');
        const revealedTicket = document.getElementById('revealed-ticket');
        const ticketGlare = document.getElementById('ticket-glare');
        const shakeProgressBar = document.getElementById('shake-progress-bar');
        const enableSensorsBtn = document.getElementById('enable-sensors-btn');
        const manualOpenBtn = document.getElementById('manual-open-btn');
        const controlsArea = document.getElementById('controls-area');
        const audioToggleBtn = document.getElementById('audio-toggle-btn');
        const audioIcon = document.getElementById('audio-icon');
        const audioLabel = document.getElementById('audio-label');
        const customUrlInput = document.getElementById('custom-url-input');
        const localFileWarning = document.getElementById('local-file-warning');
        const headerBadgeText = document.getElementById('header-badge-text');
        const statusDot = document.getElementById('status-dot');
        const pageFooter = document.getElementById('page-footer');

        // ---------------------------------------------------------------------
        // 1. GESTIONE QR CODE E NAVIGAZIONE
        // ---------------------------------------------------------------------
        let qrInstance = null;

        function renderQRCode(targetUrl) {
            const qrContainer = document.getElementById('qrcode');
            if (!qrContainer) return;
            qrContainer.innerHTML = '';
            qrInstance = new QRCode(qrContainer, {
                text: targetUrl,
                width: 190,
                height: 190,
                colorDark: "#000000",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.H
            });
        }

        function initApp() {
            const urlParams = new URLSearchParams(window.location.search);
            const currentUrl = window.location.href;
            const isLocal = window.location.protocol === 'file:' || currentUrl.includes('about:srcdoc') || currentUrl.includes('localhost');

            // Genera URL pulito per il QR code aggiungendo ?mode=gift
            let qrTarget = currentUrl.split('?')[0] + '?mode=gift';
            if (isLocal) {
                localFileWarning.classList.remove('hidden');
                qrTarget = 'https://dune-gift-demo.example.com/?mode=gift';
            }
            renderQRCode(qrTarget);

            // Se l'URL ha ?mode=qr mostra subito la schermata QR
            if (urlParams.get('mode') === 'qr') {
                showQrScreen();
            } else {
                showGiftScreen();
            }
        }

        function showQrScreen() {
            qrScreen.classList.remove('hidden');
            giftScreen.classList.add('hidden');
            toggleQrBtn.textContent = 'Torna al Biglietto';
        }

        function showGiftScreen() {
            qrScreen.classList.add('hidden');
            giftScreen.classList.remove('hidden');
            toggleQrBtn.textContent = 'Mostra QR Regalo';
        }

        toggleQrBtn.addEventListener('click', () => {
            if (qrScreen.classList.contains('hidden')) {
                showQrScreen();
            } else {
                showGiftScreen();
            }
        });

        previewExpBtn.addEventListener('click', showGiftScreen);

        customUrlInput.addEventListener('input', (e) => {
            const val = e.target.value.trim();
            if (val) {
                renderQRCode(val);
            }
        });

        // ---------------------------------------------------------------------
        // 2. COLONNA SONORA ORIGINALE HANS ZIMMER (Con fallback sintetizzato)
        // ---------------------------------------------------------------------
        async function startDuneSoundtrack() {
            if (isAudioPlaying) return;
            isAudioPlaying = true;
            audioToggleBtn.classList.remove('hidden');

            // 1. Prova ad avviare la colonna sonora originale ufficiale di Hans Zimmer via YouTube Player
            if (ytReady && ytPlayer && typeof ytPlayer.playVideo === 'function') {
                try {
                    ytPlayer.unMute();
                    ytPlayer.setVolume(100);
                    ytPlayer.playVideo();
                    return; // Colonna sonora originale avviata con successo
                } catch (e) {
                    console.warn("Fallback su sintesi audio:", e);
                }
            }

            // 2. Fallback sintetizzato stile Hans Zimmer se il player esterno è bloccato/offline
            try {
                await Tone.start();

                const zimmerReverb = new Tone.Reverb({
                    decay: 7.5,
                    wet: 0.6
                }).toDestination();

                const brassDrone = new Tone.FMSynth({
                    harmonicity: 0.5,
                    modulationIndex: 3.5,
                    oscillator: { type: "sawtooth" },
                    envelope: { attack: 1.5, decay: 1.5, sustain: 0.9, release: 3 },
                    modulation: { type: "triangle" }
                }).connect(zimmerReverb);
                brassDrone.volume.value = -9;

                const chorusLead = new Tone.PolySynth(Tone.AMSynth, {
                    harmonicity: 2,
                    oscillator: { type: "sawtooth" },
                    envelope: { attack: 0.35, decay: 0.4, sustain: 0.85, release: 1.8 },
                    modulation: { type: "sine" }
                }).connect(zimmerReverb);
                chorusLead.volume.value = -7;

                const epicHorns = new Tone.PolySynth(Tone.FMSynth, {
                    harmonicity: 1,
                    modulationIndex: 2,
                    oscillator: { type: "sawtooth" },
                    envelope: { attack: 0.6, decay: 0.5, sustain: 0.8, release: 2.2 }
                }).connect(zimmerReverb);
                epicHorns.volume.value = -11;

                const taikoDrum = new Tone.MembraneSynth({
                    pitchDecay: 0.09,
                    octaves: 5,
                    oscillator: { type: "sine" },
                    envelope: { attack: 0.008, decay: 0.9, sustain: 0.01, release: 1.4 }
                }).connect(zimmerReverb);
                taikoDrum.volume.value = -5;

                brassDrone.triggerAttack("D1");

                const refrainSteps = [
                    { lead: ["D4", "A4"], horn: ["D3", "A3"], drum: "D1", dur: "2n" },
                    { lead: ["Eb4", "Bb4"], horn: ["Eb3", "Bb3"], drum: null, dur: "4n" },
                    { lead: ["F#4", "D5"], horn: ["D3", "F#3"], drum: "A0", dur: "4n" },
                    { lead: ["G4", "Eb5"], horn: ["G2", "D3"], drum: "D1", dur: "2n" },
                    { lead: ["A4", "F#5"], horn: ["D3", "A3"], drum: null, dur: "2n" },
                    { lead: ["Bb4", "G5"], horn: ["G2", "Bb2"], drum: "D1", dur: "4n" },
                    { lead: ["A4", "F#5"], horn: ["D3", "A3"], drum: null, dur: "4n" },
                    { lead: ["G4", "Eb5"], horn: ["Eb3", "G3"], drum: "A0", dur: "2n" },
                    { lead: ["F#4", "D5"], horn: ["D3", "A3"], drum: "D1", dur: "2n" },
                    { lead: ["Eb4", "Bb4"], horn: ["Bb2", "Eb3"], drum: null, dur: "4n" },
                    { lead: ["D4", "A4"], horn: ["D2", "A2"], drum: "D1", dur: "2n." }
                ];

                let stepIndex = 0;
                Tone.Transport.bpm.value = 72;

                duneSynthLoop = new Tone.Loop((time) => {
                    const current = refrainSteps[stepIndex % refrainSteps.length];

                    if (current.drum) {
                        taikoDrum.triggerAttackRelease(current.drum, "2n", time);
                    }
                    if (current.horn) {
                        epicHorns.triggerAttackRelease(current.horn, current.dur, time);
                    }
                    if (current.lead) {
                        chorusLead.triggerAttackRelease(current.lead, current.dur, time);
                    }

                    stepIndex++;
                }, "2n").start(0);

                Tone.Transport.start();

                window._duneAudio = { brassDrone, chorusLead, epicHorns, taikoDrum };

            } catch (err) {
                console.warn("Audio non avviato automaticamente:", err);
            }
        }

        // Gestione pulsante Mute / Unmute (sincronizzato sia per YouTube originale che per Tone.js)
        audioToggleBtn.addEventListener('click', () => {
            if (!isAudioPlaying) {
                startDuneSoundtrack();
                return;
            }
            isAudioMuted = !isAudioMuted;

            if (ytReady && ytPlayer && typeof ytPlayer.mute === 'function') {
                if (isAudioMuted) {
                    ytPlayer.mute();
                } else {
                    ytPlayer.unMute();
                    ytPlayer.playVideo();
                }
            }

            if (typeof Tone !== 'undefined') {
                Tone.Destination.mute = isAudioMuted;
            }

            if (isAudioMuted) {
                audioIcon.textContent = "🔇";
                audioLabel.textContent = "Audio OFF";
            } else {
                audioIcon.textContent = "🔊";
                audioLabel.textContent = "Audio ON";
            }
        });

        // ---------------------------------------------------------------------
        // 3. RILEVAMENTO SCUOTIMENTO (Accelerometro + Fallback Touch/Click)
        // ---------------------------------------------------------------------
        function addShakeEnergy(amount) {
            if (isUnwrapped) return;

            shakeEnergy = Math.min(ENERGY_TO_OPEN, shakeEnergy + amount);
            shakeProgressBar.style.width = `${shakeEnergy}%`;

            // Animazione vibrazione visiva
            silverWrapper.classList.remove('shake-anim');
            void silverWrapper.offsetWidth; // Force reflow
            silverWrapper.classList.add('shake-anim');

            // Vibrazione aptica del telefono se supportata
            if (navigator.vibrate) {
                navigator.vibrate(60);
            }

            // Se l'energia raggiunge il 100%, apre il pacchetto argentato!
            if (shakeEnergy >= ENERGY_TO_OPEN) {
                unwrapPackage();
            }
        }

        function handleDeviceMotion(event) {
            if (isUnwrapped) return;
            const acc = event.accelerationIncludingGravity || event.acceleration;
            if (!acc) return;

            const totalAcc = Math.sqrt(
                (acc.x || 0) * (acc.x || 0) +
                (acc.y || 0) * (acc.y || 0) +
                (acc.z || 0) * (acc.z || 0)
            );

            // Sottraiamo la gravità terrestre (~9.8 m/s²)
            const delta = Math.abs(totalAcc - 9.8);

            if (delta > SHAKE_THRESHOLD) {
                const now = Date.now();
                if (now - lastShakeTime > 120) {
                    lastShakeTime = now;
                    addShakeEnergy(35); // Bastano circa 3 scuotimenti decisi
                }
            }
        }

        // Richiesta permessi sensori per iOS 13+
        enableSensorsBtn.addEventListener('click', async () => {
            // Sblocca subito il contesto audio al primo tocco dell'utente
            if (typeof Tone !== 'undefined' && Tone.context.state !== 'running') {
                await Tone.start();
            }

            if (typeof DeviceMotionEvent !== 'undefined' && typeof DeviceMotionEvent.requestPermission === 'function') {
                try {
                    const permissionState = await DeviceMotionEvent.requestPermission();
                    if (permissionState === 'granted') {
                        window.addEventListener('devicemotion', handleDeviceMotion);
                        enableSensorsBtn.innerHTML = '<span>✅</span> Sensori Attivi! Ora scuoti il telefono';
                        enableSensorsBtn.classList.replace('border-zinc-600', 'border-sky-400');
                    }
                } catch (error) {
                    console.error("Permesso accelerometro negato:", error);
                }
            } else {
                window.addEventListener('devicemotion', handleDeviceMotion);
            }
        });

        // Attiva subito listener su Android / browser che non richiedono permesso esplicito
        if (typeof window !== 'undefined' && 'DeviceMotionEvent' in window) {
            window.addEventListener('devicemotion', handleDeviceMotion);
        }

        // Interazione tramite tocco ripetuto sull'involucro argentato o pulsante manuale
        silverWrapper.addEventListener('click', () => {
            addShakeEnergy(35);
        });

        manualOpenBtn.addEventListener('click', () => {
            addShakeEnergy(100);
        });

        // ---------------------------------------------------------------------
        // 4. APERTURA DEL PACCHETTO ARGENTATO E RIVELAZIONE BIGLIETTO
        // ---------------------------------------------------------------------
        function unwrapPackage() {
            if (isUnwrapped) return;
            isUnwrapped = true;

            // Vibrazione lunga di conferma
            if (navigator.vibrate) {
                navigator.vibrate([100, 50, 200]);
            }

            // Nasconde il sigillo centrale
            wrapperSeal.style.opacity = '0';

            // Separa le due metà dell'involucro argentato
            silverWrapper.classList.add('unwrapped');

            // Rivela il biglietto sottostante con effetto zoom e bagliore
            setTimeout(() => {
                revealedTicket.classList.remove('opacity-0', 'scale-95', 'transition-all', 'duration-1000');
                revealedTicket.classList.add('opacity-100', 'scale-100');
                revealedTicket.style.transition = 'transform 0.14s ease-out, opacity 0.8s ease';
                revealedTicket.style.pointerEvents = 'auto';
                revealedTicket.style.zIndex = '25';
                silverWrapper.style.pointerEvents = 'none';
                controlsArea.classList.add('hidden');

                // Aggiorna intestazione e footer solo DOPO l'apertura del pacchetto
                headerBadgeText.textContent = "Arrakis Pass";
                headerBadgeText.classList.replace('text-zinc-400', 'text-amber-200/70');
                statusDot.classList.replace('bg-zinc-400', 'bg-sky-400');
                statusDot.classList.replace('shadow-[0_0_10px_#a1a1aa]', 'shadow-[0_0_10px_#38bdf8]');
                pageFooter.textContent = "La Spezia deve scorrere • Arrakis";
            }, 250);

            // Fa partire la colonna sonora epica di Dune
            startDuneSoundtrack();

            // Accelera le particelle di Spezia dorata e blu
            boostSpiceParticles();
        }

        // ---------------------------------------------------------------------
        // 4B. INCLINAZIONE 3D E RIFLESSO LUCIDO AL TOCCO SUL BIGLIETTO
        // ---------------------------------------------------------------------
        function updateTicketTilt(clientX, clientY) {
            if (!isUnwrapped) return;
            const rect = revealedTicket.getBoundingClientRect();
            const relX = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
            const relY = Math.max(0, Math.min(1, (clientY - rect.top) / rect.height));

            // Piegatura 3D: il punto toccato si flette verso l'interno come carta lucida
            const rotateY = (relX - 0.5) * 32;
            const rotateX = (0.5 - relY) * 32;

            revealedTicket.style.transition = 'transform 0.05s ease-out';
            revealedTicket.style.transform = `perspective(1100px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.025)`;

            // Riflesso lucido dinamico posizionato sul punto del tocco
            const glareX = relX * 100;
            const glareY = relY * 100;
            ticketGlare.style.opacity = '1';
            ticketGlare.style.background = `radial-gradient(circle at ${glareX}% ${glareY}%, rgba(255, 252, 232, 0.55) 0%, rgba(251, 191, 36, 0.24) 30%, rgba(56, 189, 248, 0.12) 56%, transparent 78%)`;
        }

        function resetTicketTilt() {
            if (!isUnwrapped) return;
            revealedTicket.style.transition = 'transform 0.55s cubic-bezier(0.22, 1, 0.36, 1)';
            revealedTicket.style.transform = 'perspective(1100px) rotateX(0deg) rotateY(0deg) scale(1)';
            ticketGlare.style.opacity = '0';
        }

        // Eventi Pointer (supporto unificato touch + mouse + stilo)
        revealedTicket.addEventListener('pointerdown', (e) => {
            if (!isUnwrapped) return;
            try {
                revealedTicket.setPointerCapture(e.pointerId);
            } catch (_) {}
            updateTicketTilt(e.clientX, e.clientY);
        });

        revealedTicket.addEventListener('pointermove', (e) => {
            if (!isUnwrapped) return;
            if (e.pointerType === 'mouse' || e.buttons > 0 || e.pressure > 0) {
                updateTicketTilt(e.clientX, e.clientY);
            }
        });

        revealedTicket.addEventListener('pointerup', resetTicketTilt);
        revealedTicket.addEventListener('pointercancel', resetTicketTilt);
        revealedTicket.addEventListener('mouseleave', resetTicketTilt);

        // ---------------------------------------------------------------------
        // 5. EFFETTO PARTICELLARE SPEZIA MELANGE (Canvas Responsive)
        // ---------------------------------------------------------------------
        const canvas = document.getElementById('spice-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];
        let particleSpeedMultiplier = 1;

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        function createParticles() {
            particles = [];
            const count = Math.min(65, Math.floor(window.innerWidth / 8));
            for (let i = 0; i < count; i++) {
                const isBlueSpice = Math.random() > 0.72; // 28% particelle blu Eyes of Ibad, 72% oro sabbia
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    radius: Math.random() * 2.2 + 0.6,
                    vx: (Math.random() - 0.5) * 0.6,
                    vy: -(Math.random() * 0.7 + 0.2),
                    alpha: Math.random() * 0.7 + 0.2,
                    color: isBlueSpice ? '56, 189, 248' : '245, 158, 11'
                });
            }
        }

        function boostSpiceParticles() {
            particleSpeedMultiplier = 2.8;
            setTimeout(() => {
                particleSpeedMultiplier = 1.2;
            }, 3000);
        }

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            for (let p of particles) {
                p.x += p.vx * particleSpeedMultiplier;
                p.y += p.vy * particleSpeedMultiplier;

                // Rientro dai bordi
                if (p.y < -10) {
                    p.y = canvas.height + 10;
                    p.x = Math.random() * canvas.width;
                }
                if (p.x < -10) p.x = canvas.width + 10;
                if (p.x > canvas.width + 10) p.x = -10;

                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(${p.color}, ${p.alpha})`;
                ctx.shadowBlur = 8;
                ctx.shadowColor = `rgba(${p.color}, 0.8)`;
                ctx.fill();
            }

            requestAnimationFrame(animateParticles);
        }

        window.addEventListener('resize', () => {
            resizeCanvas();
            createParticles();
        });

        // Avvio all'apertura della finestra
        window.onload = function () {
            resizeCanvas();
            createParticles();
            animateParticles();
            initApp();
        };
    </script>
