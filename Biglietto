    </header>

    <!-- ===================================================================== -->
    <!-- SEZIONE 1: SCHERMATA QR CODE (Da mostrare al festeggiato/destinatario) -->
    <!-- ===================================================================== -->
    <main id="qr-screen" class="hidden z-20 flex-1 flex flex-col items-center justify-center px-6 py-8 text-center max-w-md w-full">
        <div class="bg-zinc-950/90 border border-zinc-700/60 rounded-3xl p-8 shadow-2xl backdrop-blur-md w-full">
            <p class="text-xs uppercase tracking-[0.3em] text-zinc-400 mb-2">Sorpresa Digitale</p>
            <h1 class="font-dune text-2xl sm:text-3xl font-bold text-zinc-100 mb-6">UN DONO PER TE</h1>
            
            <!-- Contenitore QR Code -->
            <div class="bg-white p-4 rounded-2xl inline-block shadow-[0_0_30px_rgba(245,158,11,0.25)] mb-6">
                <div id="qrcode"></div>
            </div>

            <p class="text-sm text-zinc-300 leading-relaxed mb-4">
                Inquadra il codice QR con la fotocamera del tuo telefono per ricevere il tuo pacchetto sigillato.
            </p>
            
