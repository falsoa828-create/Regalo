
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Dune: Parte Tre - Biglietto Regalo</title>
    <!-- Tailwind CSS per layout e utilità responsive -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- QRCode.js per generare il codice QR dinamicamente -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <!-- Tone.js per la colonna sonora epica sintetizzata (nessun file esterno richiesto) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <!-- Google Fonts: Cinzel per lo stile epico Dune e Inter per i dettagli -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    
    <style>
        /* Stili personalizzati per effetti metallici, particelle e animazioni cinematografiche */
        body {
            background-color: #050505;
            color: #f3e5ab;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            user-select: none;
            -webkit-user-select: none;
        }

        .font-dune {
            font-family: 'Cinzel', serif;
            letter-spacing: 0.25em;
        }

        /* Effetto involto argentato metallizzato */
        .silver-foil {
            background: linear-gradient(
                135deg,
                #8e9eab 0%,
                #eef2f3 20%,
                #7b868e 40%,
                #ffffff 50%,
                #68737a 70%,
                #d7dde8 85%,
                #5c666d 100%
            );
            background-size: 200% 200%;
            animation: foilShimmer 6s ease infinite;
            box-shadow: 
                0 25px 50px -12px rgba(0, 0, 0, 0.95),
                inset 0 0 30px rgba(255, 255, 255, 0.4),
                inset 0 0 10px rgba(0, 0, 0, 0.6);
            position: relative;
            overflow: hidden;
        }

        /* Texture pieghe carta stagnola / metallizzata */
        .silver-foil::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.4) 0%, transparent 40%),
                              radial-gradient(circle at 80% 70%, rgba(0,0,0,0.3) 0%, transparent 50%),
                              repeating-linear-gradient(45deg, rgba(255,255,255,0.05) 0px, rgba(255,255,255,0.05) 2px, transparent 2px, transparent 8px);
            pointer-events: none;
        }

        @keyframes foilShimmer {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Animazione di vibrazione quando si scuote */
        .shake-anim {
            animation: shakeHard 0.4s cubic-bezier(.36,.07,.19,.97) both;
        }

        @keyframes shakeHard {
            10%, 90% { transform: translate3d(-4px, 0, 0) rotate(-1deg); }
            20%, 80% { transform: translate3d(6px, 0, 0) rotate(2deg); }
            30%, 50%, 70% { transform: translate3d(-8px, 0, 0) rotate(-2deg); }
            40%, 60% { transform: translate3d(8px, 0, 0) rotate(1deg); }
        }

        /* Animazione apertura involucro (sinistra e destra si separano) */
        .foil-half-left {
            transition: transform 1.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 1.2s ease;
        }
        .foil-half-right {
            transition: transform 1.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 1.2s ease;
        }

        .unwrapped .foil-half-left {
            transform: translateX(-130%) rotate(-18deg) scale(0.9);
            opacity: 0;
            pointer-events: none;
        }
        .unwrapped .foil-half-right {
            transform: translateX(130%) rotate(18deg) scale(0.9);
            opacity: 0;
            pointer-events: none;
        }

        /* Bagliore Spezia (Melange) blu elettrico e oro deserto */
        .spice-glow {
            box-shadow: 
                0 0 25px rgba(245, 158, 11, 0.55),
                0 0 60px rgba(217, 119, 6, 0.35),
                0 0 90px rgba(56, 189, 248, 0.2),
                inset 0 0 18px rgba(251, 191, 36, 0.35);
            animation: borderPulseGlow 4s ease-in-out infinite alternate;
        }

        @keyframes borderPulseGlow {
            0% {
                border-color: rgba(251, 191, 36, 0.85);
                box-shadow: 
                    0 0 22px rgba(245, 158, 11, 0.5),
                    0 0 55px rgba(217, 119, 6, 0.3),
                    inset 0 0 15px rgba(251, 191, 36, 0.25);
            }
            100% {
                border-color: rgba(253, 230, 138, 1);
                box-shadow: 
                    0 0 34px rgba(251, 191, 36, 0.85),
                    0 0 75px rgba(56, 189, 248, 0.35),
                    inset 0 0 24px rgba(253, 224, 71, 0.45);
            }
        }

        /* Effetto 3D e riflesso lucido al tocco sul biglietto */
        #package-stage {
            perspective: 1100px;
        }

        #revealed-ticket {
            transform-style: preserve-3d;
            will-change: transform;
            position: relative;
            overflow: hidden;
            touch-action: none;
            -webkit-tap-highlight-color: transparent;
        }

        #ticket-glare {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 30;
            opacity: 0;
            transition: opacity 0.2s ease;
            background: radial-gradient(
                circle at 50% 50%,
                rgba(255, 252, 230, 0.5) 0%,
                rgba(251, 191, 36, 0.22) 32%,
                rgba(56, 189, 248, 0.1) 58%,
                transparent 78%
            );
            mix-blend-mode: screen;
        }

        .eyes-of-ibad {
            text-shadow: 0 0 12px rgba(56, 189, 248, 0.9), 0 0 24px rgba(14, 165, 233, 0.6);
        }

        /* Bordo traforato stile biglietto cinema */
        .ticket-perforation {
            border-top: 2px dashed rgba(217, 119, 6, 0.4);
            position: relative;
        }
        .ticket-perforation::before, .ticket-perforation::after {
            content: '';
            position: absolute;
            top: -12px;
            width: 22px;
            height: 22px;
            background-color: #050505;
            border-radius: 50%;
        }
        .ticket-perforation::before { left: -28px; }
        .ticket-perforation::after { right: -28px; }

        /* Particelle di sabbia/spezia fluttuanti */
        #spice-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-between relative selection:bg-amber-600 selection:text-black">

    <!-- Canvas per polvere di Spezia (Melange) dorata e blu -->
    <canvas id="spice-canvas"></canvas>

    <!-- Barra superiore discreta per passare tra Modalità Regalo e Modalità QR Code -->
    <header class="w-full z-30 p-4 flex justify-between items-center max-w-2xl mx-auto">
        <div class="flex items-center space-x-2">
            <span class="w-2.5 h-2.5 rounded-full bg-zinc-400 animate-pulse shadow-[0_0_10px_#a1a1aa]" id="status-dot"></span>
            <span id="header-badge-text" class="text-xs uppercase tracking-widest text-zinc-400 font-semibold">Regalo Riservato</span>
        </div>
        
        <div class="flex items-center space-x-2">
            <!-- Pulsante Audio Mute/Unmute -->
            <button id="audio-toggle-btn" class="hidden px-3 py-1.5 rounded-full bg-zinc-900/90 border border-amber-500/30 text-amber-300 text-xs flex items-center gap-1.5 hover:bg-zinc-800 transition">
                <span id="audio-icon">🔊</span>
                <span id="audio-label">Audio ON</span>
